# Chain adapter: "mock" (demo data, no wallet needed) or "live" (ForrelRegistry on Diana).
NEXT_PUBLIC_CHAIN_MODE=mock

# Deployed ForrelRegistry on QoreChain Diana (deployments/diana.json → ForrelRegistry).
# Required when NEXT_PUBLIC_CHAIN_MODE=live.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Optional: the block it was deployed at (deployments/diana.json → deployedAtBlock).
# Lets the app find transaction links in event logs; verdicts never depend on it.
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK=

# Only needed if adding WalletConnect wallets; QoreX and injected wallets do not use it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
