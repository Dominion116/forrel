{
  "name": "@forrel/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foundry smart contracts for ForrelRegistry on QoreChain, with the EVM authorisation window helper.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "abi": "forge build && node scripts/export-abi.mjs",
    "e2e": "tsx scripts/live-e2e.ts",
    "coverage": "forge coverage --report summary --no-match-coverage \"(test|script)/\"",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "forge script script/Deploy.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.16"
  }
}
